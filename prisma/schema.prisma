generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon pooled connection (host contains "-pooler") — used by the running app.
  url       = env("DATABASE_URL")
  // Neon direct connection — used by `prisma migrate`. For a local Postgres,
  // set this to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  MAIN_ADMIN
  MANAGER
  DRIVER
  PARENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum NotificationType {
  SCHOOL_REGISTERED
  SCHOOL_APPROVED
  SCHOOL_REJECTED
  MANAGER_INVITED
  MANAGER_ACCEPTED
  MAIN_ADMIN_TRANSFERRED
  DRIVER_ACCEPTED
  PARENT_LINK_REQUESTED
  PARENT_APPROVED
  PARENT_REJECTED
  PARENT_LINK_APPROVED
  PARENT_LINK_REJECTED
  // Trips & transport (M9)
  TRIP_STARTED
  STUDENT_BOARDED
  STUDENT_DROPPED_OFF
  STUDENT_ABSENT
  BUS_APPROACHING
  TRIP_ENDED_WITH_ONBOARD
  BUS_ASSIGNED
}

/// PRD §5. A parent's standing with a school, separate from their links.
enum ParentAccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// PRD §5. Each parent↔student link is reviewed independently.
enum ParentLinkStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

/// PRD M7. MORNING = home → school, AFTERNOON = school → home.
enum TripDirection {
  MORNING
  AFTERNOON
}

enum TripStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A student's state on one trip. PENDING = not yet on the bus.
enum TripStudentStatus {
  PENDING
  BOARDED
  DROPPED_OFF
  ABSENT
}

enum ParentRelationship {
  MOTHER
  FATHER
  GUARDIAN
  GRANDPARENT
  SIBLING
  OTHER
}

/// Driver lifecycle (PRD M4). INVITED until the driver accepts their
/// invitation; ACTIVE drivers can sign in to the Driver Portal.
enum DriverStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

/// PRD M5. MAINTENANCE buses stay on their routes but are flagged; RETIRED
/// buses must first be removed from every route.
enum BusStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED_OUT
}

// Covers Nigerian school system: Nursery, Primary, Junior/Senior Secondary
enum ClassGrade {
  NURSERY_1
  NURSERY_2
  NURSERY_3
  PRIMARY_1
  PRIMARY_2
  PRIMARY_3
  PRIMARY_4
  PRIMARY_5
  PRIMARY_6
  JSS_1
  JSS_2
  JSS_3
  SS_1
  SS_2
  SS_3
  OTHER
}

enum ImportStatus {
  PENDING
  PROCESSING
  // Validated; preview ready, awaiting admin confirmation
  COMPLETED
  FAILED
  // Admin confirmed; valid rows committed as students (terminal)
  CONFIRMED
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  email        String        @unique
  phone        String?
  password     String
  isSuperAdmin Boolean       @default(false) @map("is_super_admin")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  memberships              SchoolMembership[]
  notifications            Notification[]
  auditLogs                AuditLog[]
  managerInvitationsMade   ManagerInvitation[] @relation("ManagerInviter")
  managerInvitationsAccepted ManagerInvitation[] @relation("ManagerAccepted")
  studentImports           StudentImport[]
  driverProfile            Driver?            @relation("DriverUser")
  driversCreated           Driver[]           @relation("DriverCreator")
  driverInvitationsMade    DriverInvitation[] @relation("DriverInviter")
  parentAccounts           ParentAccount[]
  pushSubscriptions        PushSubscription[]

  @@map("users")
}

model School {
  id     String @id @default(uuid())
  name   String
  // Opaque, public-safe identifier used for school-scoped links (e.g. parent
  // invites). Never expose the internal sequential/primary id in URLs.
  publicToken String @unique @default(uuid()) @map("public_token")

  accountStatus    AccountStatus    @default(ACTIVE) @map("account_status")
  onboardingStatus OnboardingStatus @default(IN_PROGRESS) @map("onboarding_status")
  approvalStatus   ApprovalStatus   @default(PENDING) @map("approval_status")

  // Approval workflow audit fields
  rejectionReason String?   @map("rejection_reason")
  approvedAt      DateTime? @map("approved_at")
  approvedBy      String?   @map("approved_by")
  rejectedAt      DateTime? @map("rejected_at")
  rejectedBy      String?   @map("rejected_by")

  // Onboarding metadata (descriptive only — never operational records)
  type                   String?
  ownership              String?
  logoUrl                String?   @map("logo_url")
  website                String?
  officialEmail          String?   @map("official_email")
  officialPhone          String?   @map("official_phone")
  altPhone               String?   @map("alt_phone")
  country                String?
  state                  String?
  lga                    String?
  city                   String?
  fullAddress            String?   @map("full_address")
  transportationSnapshot Json?     @map("transportation_snapshot")
  goals                  String?
  referralSource         String?   @map("referral_source")
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at")

  // Last allocated number for generated studentIds (AJO-000001, ...).
  // Incremented atomically — never derive IDs from a row count.
  studentIdSeq Int @default(0) @map("student_id_seq")
  // Same scheme for driverIds (DRV-000001, ...).
  driverIdSeq  Int @default(0) @map("driver_id_seq")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        SchoolMembership[]
  managerInvitations ManagerInvitation[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  buses              Bus[]
  students           Student[]
  studentImports     StudentImport[]
  studentTransportAssignments StudentTransportAssignment[]
  drivers                     Driver[]
  routes                      Route[]
  parentAccounts              ParentAccount[]
  parentLinks                 ParentStudent[]
  trips                       Trip[]
  driverInvitations           DriverInvitation[]

  @@index([approvalStatus])
  @@map("schools")
}

model SchoolMembership {
  id       String           @id @default(uuid())
  userId   String           @map("user_id")
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String           @map("school_id")
  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role     UserRole
  status   MembershipStatus @default(ACTIVE)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([userId, schoolId])
  @@index([schoolId, role])
  @@map("school_memberships")
}

model ManagerInvitation {
  id        String           @id @default(uuid())
  schoolId  String           @map("school_id")
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email     String
  firstName String           @map("first_name")
  lastName  String           @map("last_name")
  phone     String?
  tokenHash String           @unique @map("token_hash")
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")
  invitedById String?        @map("invited_by_id")
  invitedBy   User?          @relation("ManagerInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUserId String?     @map("accepted_user_id")
  acceptedUser   User?       @relation("ManagerAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now()) @map("created_at")
  acceptedAt DateTime?       @map("accepted_at")

  @@index([schoolId, status])
  @@index([email])
  @@map("manager_invitations")
}

// ---------------------------------------------------------------------------
// Drivers (PRD M4)
// ---------------------------------------------------------------------------

/// A driver employed by a school. Created by a Main Admin/Manager; the linked
/// User account (role DRIVER) only exists once the invitation is accepted.
model Driver {
  id       String @id @default(uuid())
  // School-scoped, human-readable identifier (e.g. DRV-000012).
  driverId String @map("driver_id")
  schoolId String @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Set when the invitation is accepted.
  userId String? @unique @map("user_id")
  user   User?   @relation("DriverUser", fields: [userId], references: [id], onDelete: SetNull)

  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  // Login email, lower-cased. Editable until the driver has an account.
  email       String
  phone       String
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      Gender?
  address     String?

  // Licence / compliance
  licenseNumber       String   @map("license_number")
  licenseClass        String?  @map("license_class")
  licenseExpiry       DateTime @map("license_expiry") @db.Date
  licenseIssuingState String?  @map("license_issuing_state")
  yearsOfExperience   Int?     @map("years_of_experience")

  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")

  status DriverStatus @default(INVITED)

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("DriverCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  invitations DriverInvitation[]
  // The bus this driver is assigned to (M5); at most one.
  bus         Bus?
  trips       Trip[]

  @@unique([schoolId, driverId])
  @@unique([schoolId, email])
  @@unique([schoolId, licenseNumber])
  @@index([schoolId, status])
  @@index([schoolId, licenseExpiry])
  @@map("drivers")
}

/// Single-use, time-limited invitation for a Driver to set up their account.
/// Resending revokes the previous pending invitation.
model DriverInvitation {
  id          String           @id @default(uuid())
  schoolId    String           @map("school_id")
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  driverId    String           @map("driver_id")
  driver      Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String           @unique @map("token_hash")
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  invitedById String?          @map("invited_by_id")
  invitedBy   User?            @relation("DriverInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  acceptedAt  DateTime?        @map("accepted_at")

  @@index([driverId, status])
  @@index([schoolId, status])
  @@map("driver_invitations")
}

// ---------------------------------------------------------------------------
// Parents (PRD M6)
// ---------------------------------------------------------------------------

/// A parent registered with a school through its public invite link. The
/// login lives on User + a PARENT SchoolMembership; this holds the review state.
model ParentAccount {
  id       String @id @default(uuid())
  schoolId String @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          ParentAccountStatus @default(PENDING)
  rejectionReason String?             @map("rejection_reason")
  reviewedAt      DateTime?           @map("reviewed_at")
  reviewedById    String?             @map("reviewed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links ParentStudent[]

  @@unique([schoolId, userId])
  @@index([schoolId, status])
  @@map("parent_accounts")
}

/// A parent's request to be linked to a student, and its review outcome.
/// Parents can only ever see students whose link is APPROVED.
model ParentStudent {
  id        String        @id @default(uuid())
  schoolId  String        @map("school_id")
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId  String        @map("parent_id")
  parent    ParentAccount @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String        @map("student_id")
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  relationship ParentRelationship
  status       ParentLinkStatus   @default(PENDING)
  // The parent's phone matches the guardian phone on the student record —
  // a hint for the reviewer, never an automatic approval.
  phoneMatchesGuardian Boolean @default(false) @map("phone_matches_guardian")
  note                 String?

  rejectionReason String?   @map("rejection_reason")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedById    String?   @map("reviewed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([parentId, studentId])
  @@index([schoolId, status])
  @@index([studentId])
  @@map("parent_students")
}

// ---------------------------------------------------------------------------
// Trips (PRD M7)
// ---------------------------------------------------------------------------

/// One run of a route by its bus and driver on a given school day.
model Trip {
  id        String        @id @default(uuid())
  schoolId  String        @map("school_id")
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routeId   String        @map("route_id")
  route     Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  busId     String?       @map("bus_id")
  bus       Bus?          @relation(fields: [busId], references: [id], onDelete: SetNull)
  driverId  String?       @map("driver_id")
  driver    Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  direction TripDirection
  status    TripStatus    @default(IN_PROGRESS)
  // School-local calendar day the trip belongs to.
  serviceDate DateTime @map("service_date") @db.Date

  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")
  cancelledReason    String?   @map("cancelled_reason")
  // Students still marked on the bus when an afternoon trip was force-ended.
  endedWithOnBoard   Int       @default(0) @map("ended_with_on_board")

  // Latest GPS fix from the driver's phone (M8), for cheap live reads.
  lastLat         Float?    @map("last_lat")
  lastLng         Float?    @map("last_lng")
  lastSpeedMps    Float?    @map("last_speed_mps")
  lastLocationAt  DateTime? @map("last_location_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  students  TripStudent[]
  locations TripLocation[]

  @@index([schoolId, serviceDate])
  @@index([routeId, serviceDate, direction])
  @@index([driverId, status])
  @@map("trips")
}

/// GPS breadcrumbs sent by the driver's phone during a trip (PRD M8).
/// Kept for 30 days, then deleted.
model TripLocation {
  id         BigInt   @id @default(autoincrement())
  tripId     String   @map("trip_id")
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speedMps   Float?   @map("speed_mps")
  heading    Float?
  accuracyM  Float?   @map("accuracy_m")
  recordedAt DateTime @map("recorded_at")
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([tripId, recordedAt])
  @@index([recordedAt])
  @@map("trip_locations")
}

/// The trip's manifest: a snapshot of the route's students when it started.
model TripStudent {
  id           String            @id @default(uuid())
  tripId       String            @map("trip_id")
  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  studentId    String            @map("student_id")
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stopId       String?           @map("stop_id")
  stop         RouteStop?        @relation(fields: [stopId], references: [id], onDelete: SetNull)
  status       TripStudentStatus @default(PENDING)
  boardedAt    DateTime?         @map("boarded_at")
  droppedOffAt DateTime?         @map("dropped_off_at")
  markedAt     DateTime?         @map("marked_at")
  markedById   String?           @map("marked_by_id")

  @@unique([tripId, studentId])
  @@index([studentId])
  @@map("trip_students")
}

// ---------------------------------------------------------------------------
// Cross-cutting: audit + notifications
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  schoolId   String?  @map("school_id")
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId  String?          @map("school_id")
  school    School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  body      String
  /// In-app page to open, e.g. /parent or /school/runs/<id>.
  link      String?
  /// Same key for the same user is stored once (e.g. one "bus is near" per child per trip).
  dedupeKey String?          @map("dedupe_key")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A browser/phone that agreed to receive web push for a user (M9).
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Operational domain models (SmartSchool Bus Tracker PRD)
// NOTE: relations to the removed portal auth tables (Driver/Parent) have been
// dropped. These models remain structurally intact pending the operational
// phase; no endpoints are wired to them in the foundation phase.
// ---------------------------------------------------------------------------

/// A school bus (PRD M5).
model Bus {
  id       String @id @default(uuid())
  schoolId String @map("school_id")
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // School's own fleet number, e.g. "AJO-03". Upper-case, unique per school.
  code         String    @map("code")
  // Upper-case without spaces, unique per school.
  plateNumber  String    @map("plate_number")
  capacity     Int
  make         String?
  vehicleModel String?   @map("vehicle_model")
  year         Int?
  color        String?
  notes        String?
  status       BusStatus @default(ACTIVE)

  // One driver per bus, one bus per driver.
  driverId String? @unique @map("driver_id")
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  routes             Route[]
  trips              Trip[]
  studentAssignments StudentTransportAssignment[]
  telemetry          TelemetryLog[]
  events             ManifestEvent[]

  @@unique([schoolId, code])
  @@unique([schoolId, plateNumber])
  @@index([schoolId, status])
  @@map("buses")
}

/// A named route served by (at most) one bus, with ordered stops (PRD M5).
model Route {
  id          String  @id @default(uuid())
  schoolId    String  @map("school_id")
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?

  busId String? @map("bus_id")
  bus   Bus?    @relation(fields: [busId], references: [id], onDelete: SetNull)

  // "HH:MM" (24h), when the bus leaves for the morning pickup / afternoon drop-off.
  morningDeparture   String? @map("morning_departure")
  afternoonDeparture String? @map("afternoon_departure")

  status    RouteStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  stops              RouteStop[]
  trips              Trip[]
  studentAssignments StudentTransportAssignment[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@index([busId])
  @@map("routes")
}

model RouteStop {
  id       String @id @default(uuid())
  routeId  String @map("route_id")
  route    Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  schoolId String @map("school_id")
  // 1-based order along the route.
  sequence Int

  name        String
  landmark    String?
  address     String?
  latitude    Float?
  longitude   Float?
  // "HH:MM" (24h)
  pickupTime  String? @map("pickup_time")
  dropoffTime String? @map("dropoff_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pickupAssignments StudentTransportAssignment[]
  tripStudents      TripStudent[]

  @@index([routeId, sequence])
  @@index([schoolId])
  @@map("route_stops")
}

model Student {
  id            String        @id @default(uuid())
  // School-scoped, human-readable durable identifier (e.g. AJO-000482).
  // Generated server-side; used by all downstream systems (routes, parents, trips).
  studentId     String        @map("student_id")
  schoolId      String        @map("school_id")
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Identity fields
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  dateOfBirth   DateTime      @map("date_of_birth") @db.Date
  gender        Gender
  classGrade    ClassGrade    @map("class_grade")
  address       String

  // Guardian info — pre-populates the M6 parent-linking flow
  guardianName  String        @map("guardian_name")
  guardianPhone String        @map("guardian_phone")

  // Soft-delete semantics only: never hard-delete a student
  status        StudentStatus @default(ACTIVE)

  // Transportation lives in its own table so M5 (Buses & Routes) can populate
  // it without touching student identity. No row = not assigned.
  transportAssignment StudentTransportAssignment?

  manifestEvents ManifestEvent[]
  parentLinks    ParentStudent[]
  tripStudents   TripStudent[]

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([schoolId, studentId])
  @@index([schoolId, status])
  @@index([schoolId, classGrade])
  @@map("students")
}

/// A student's current transportation assignment (PRD M3 §3). Separate from
/// student identity; populated by Milestone 5. routeId / pickupStopId become
/// foreign keys once the Route and Stop models exist.
model StudentTransportAssignment {
  id           String   @id @default(uuid())
  studentId    String   @unique @map("student_id")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId     String   @map("school_id")
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  busId        String?  @map("bus_id")
  bus          Bus?     @relation(fields: [busId], references: [id], onDelete: SetNull)
  routeId      String?    @map("route_id")
  route        Route?     @relation(fields: [routeId], references: [id], onDelete: SetNull)
  pickupStopId String?    @map("pickup_stop_id")
  pickupStop   RouteStop? @relation(fields: [pickupStopId], references: [id], onDelete: SetNull)
  assignedAt   DateTime @default(now()) @map("assigned_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@index([busId])
  @@index([routeId])
  @@map("student_transport_assignments")
}

// ---------------------------------------------------------------------------
// Student import pipeline (async job tracking)
// ---------------------------------------------------------------------------

model StudentImport {
  id           String       @id @default(uuid())
  schoolId     String       @map("school_id")
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId      String?      @map("actor_id")
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  status       ImportStatus @default(PENDING)
  fileName     String       @map("file_name")
  totalRows    Int?         @map("total_rows")
  successCount Int?         @map("success_count")
  errorCount   Int?         @map("error_count")
  // Rows flagged as probable duplicates (warning only, still importable)
  duplicateCount Int?       @map("duplicate_count")
  // Rows actually inserted as students on confirm
  committedCount Int?       @map("committed_count")
  // Why the import FAILED (bad structure, too many rows, ...)
  failureReason String?     @map("failure_reason")
  // "sha256:<hex>" fingerprint of the uploaded file (file content itself is
  // not stored; parsed rows live in StudentImportRow.rawData)
  storageKey   String       @map("storage_key")

  rows         StudentImportRow[]

  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")
  confirmedAt  DateTime?    @map("confirmed_at")

  @@index([schoolId, status])
  @@map("student_imports")
}

model StudentImportRow {
  id            String        @id @default(uuid())
  importId      String        @map("import_id")
  import        StudentImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowIndex      Int           @map("row_index")
  rawData       Json          @map("raw_data")
  // Array of error descriptions for this row
  errorMessages String[]      @map("error_messages")
  isValid       Boolean       @map("is_valid")
  // true if flagged as a probable duplicate (same name+DOB+class), but not a hard error
  isDuplicate   Boolean       @default(false) @map("is_duplicate")
  // What the probable duplicate collided with, e.g. "AJO-000012" or "row 4"
  duplicateOf   String?       @map("duplicate_of")
  // studentId assigned when this row was committed (null = not committed)
  committedStudentId String?  @map("committed_student_id")

  @@index([importId, isValid])
  @@map("student_import_rows")
}


model TelemetryLog {
  id         BigInt   @id @default(autoincrement())
  busId      String   @map("bus_id")
  bus        Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  speedMps   Float?   @map("speed_mps")
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([busId])
  @@map("telemetry_logs")
}

model ManifestEvent {
  id              String   @id @default(uuid())
  studentId       String   @map("student_id")
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  busId           String   @map("bus_id")
  bus             Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  eventType       String   @map("event_type")
  timestamp       DateTime @default(now())
  verificationLat Float    @map("verification_lat")
  verificationLng Float    @map("verification_lng")

  @@index([studentId])
  @@index([busId])
  @@map("manifest_events")
}
