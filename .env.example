# --- Application ---
PORT=3000
NODE_ENV=production

# Public base URL of the client app — used to build invitation accept links.
APP_BASE_URL="http://localhost:3000"

# --- Database (PostgreSQL) ---
# On Railway this is injected automatically via the PostgreSQL plugin.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolguard?schema=public"

# --- Auth ---
# Generate a strong secret, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Invitations ---
# How long invitation tokens stay valid, in hours (default 7 days).
INVITATION_TTL_HOURS=168

# --- Super Admin provisioning (used by `npm run db:seed`) ---
SUPER_ADMIN_EMAIL="superadmin@schoolguard.dev"
SUPER_ADMIN_PASSWORD="change-me-super-admin-password"
SUPER_ADMIN_FIRST_NAME="Platform"
SUPER_ADMIN_LAST_NAME="Admin"

# --- Email (nodemailer) ---
# When SMTP_HOST is empty the email service logs messages instead of sending.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SchoolGuard <no-reply@schoolguard.dev>"

# --- Rate limiting ---
# Requests allowed per window (ms) for globally-throttled endpoints.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
